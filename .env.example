# Neon PostgreSQL (請使用 -pooler 連線字串)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 上帝視角登入帳密(僅存於伺服器端,勿提交至 Git)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin@2026

# 選填:Session 簽章密鑰,未設定則以 ADMIN_PASSWORD 衍生
# SESSION_SECRET=your-random-secret

# OpenAI API(貼文文案與圖片生成)
OPENAI_API_KEY=sk-your-key
# 選填:覆寫模型,預設 gpt-4o-mini / gpt-image-1
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# ElevenLabs API(Podcast TTS + 短影音 Scribe v2 轉寫)
ELEVENLABS_API_KEY=sk_your-elevenlabs-key

# 選填:社群 access token 加密金鑰,未設定則以 SESSION_SECRET 衍生
# TOKEN_ENCRYPTION_KEY=your-random-secret

# X(Twitter) API OAuth 2.0 App 憑證(developer.x.com App 的 Keys and tokens 分頁)
# 用於 refresh token 續期(functions/_shared/x.ts)與 scripts/x-oauth-setup.mjs 一次性授權腳本
# 正式環境請用 `wrangler pages secret put X_CLIENT_ID` / `X_CLIENT_SECRET` 設定,不要提交到 Git
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

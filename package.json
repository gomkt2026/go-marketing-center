{
  "name": "go-marketing-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788 --local",
    "dev:full": "npm run build && wrangler pages dev dist --port 8788 --local",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=go-marketing-center --branch=Ben",
    "export:podcast": "node scripts/export-podcast.mjs",
    "render:short": "python3 scripts/render-short-video.py",
    "x:oauth": "node scripts/x-oauth-setup.mjs",
    "network:apply": "node scripts/apply-network.mjs",
    "network:import": "node scripts/import-network.mjs",
    "editor:apply": "node scripts/apply-editor.mjs",
    "editor:setup-ale": "node scripts/setup-editor-agents.mjs washgo",
    "editor:setup-agents": "node scripts/setup-editor-agents.mjs"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@elevenlabs/react": "^1.15.2",
    "@neondatabase/serverless": "^1.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "framer-motion": "^11.11.17",
    "html5-qrcode": "^2.3.8",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.119.0"
  }
}

{
  "name": "go-marketing-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788 --local",
    "dev:full": "npm run build && wrangler pages dev dist --port 8788 --local",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=go-marketing-center --branch=main"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "framer-motion": "^11.11.17",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.119.0"
  }
}

  "cues": [
    { "id": "c01", "startMs": 300, "endMs": 4800, "narration": "修繕報修單，一鍵變成洗衣訂單。" },
    { "id": "c02", "startMs": 5200, "endMs": 9300, "narration": "以前跨業合作，資料要重填、佣金要人工對帳。" },
    { "id": "c03", "startMs": 9400, "endMs": 11200, "narration": "現在，一次搞定！" },
    { "id": "c04", "startMs": 11400, "endMs": 15600, "narration": "首先，洗衣品牌在 Washgo 後台，一鍵開放 TaskGo 轉介紹。" },
    { "id": "c05", "startMs": 15600, "endMs": 19600, "narration": "客人折扣、介紹佣金、Homigo 拆分，通通自己設定。" },
    { "id": "c06", "startMs": 19862, "endMs": 23662, "narration": "接著在 TaskGo 修繕管理，新增「洗滌服務」案件類型。" },
    { "id": "c07", "startMs": 23662, "endMs": 27062, "narration": "客戶報修時，就能直接選擇送洗。" },
    { "id": "c08", "startMs": 27328, "endMs": 31328, "narration": "每家修繕廠商都有專屬報修連結和 QR Code。" },
    { "id": "c09", "startMs": 31328, "endMs": 34728, "narration": "還能為合作夥伴建立介紹廠商專屬連結。" },
    { "id": "c10", "startMs": 34728, "endMs": 38428, "narration": "每一筆轉介來源、佣金比例，系統自動記錄。" },
    { "id": "c11", "startMs": 38603, "endMs": 42203, "narration": "客戶從介紹連結進來，介紹廠商自動帶入。" },
    { "id": "c12", "startMs": 42303, "endMs": 46103, "narration": "點選「洗滌服務」，系統列出合作的洗衣品牌。" },
    { "id": "c13", "startMs": 46103, "endMs": 49803, "narration": "選擇洗樂專業洗衣，TaskGo 客戶直接享九五折。" },
    { "id": "c14", "startMs": 50003, "endMs": 54303, "narration": "案件、組織、優惠自動帶入 Washgo，不用重填。" },
    { "id": "c15", "startMs": 54603, "endMs": 59003, "narration": "Washgo 送洗頁顯示 TaskGo 轉介紹，享九五折。" },
    { "id": "c16", "startMs": 59003, "endMs": 64003, "narration": "免運門檻、儲值方案、免責聲明，線上一次完成。" },
    { "id": "c17", "startMs": 64246, "endMs": 66346, "narration": "串接整合，四大優勢：" },
    { "id": "c18", "startMs": 66346, "endMs": 68846, "narration": "一、一張報修單，跨業接單。" },
    { "id": "c19", "startMs": 68846, "endMs": 71346, "narration": "二、轉介來源，全程追蹤。" },
    { "id": "c20", "startMs": 71346, "endMs": 73846, "narration": "三、折扣佣金，自動分潤。" },
    { "id": "c21", "startMs": 73846, "endMs": 76746, "narration": "四、品牌一鍵開關，自主控管。" },
    { "id": "c22", "startMs": 77046, "endMs": 80646, "narration": "客戶省事又省錢，修繕廠商多賺佣金。" },
    { "id": "c23", "startMs": 80646, "endMs": 83746, "narration": "洗衣品牌多了穩定客源，三方共贏。" },
    { "id": "c24", "startMs": 84146, "endMs": 87846, "narration": "TaskGo 跟 Washgo，一張報修單，串起修繕與洗滌。" }
  ]
}
